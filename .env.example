# 복사해서 .env로 쓴다: cp .env.example .env
# .env는 커밋하지 않는다.

# DB 주소. 비워 두면 로컬 SQLite(local.db)를 쓴다.
# Neon/Supabase 주소(postgresql://...?sslmode=require)를 그대로 넣어도 된다.
DATABASE_URL=

# Firebase 콘솔 > 프로젝트 설정 > 프로젝트 ID
FIREBASE_PROJECT_ID=

# 관리자 이메일 (쉼표로 구분)
ADMIN_EMAILS=

# 가입을 허용할 이메일 도메인 (쉼표로 구분). 비워 두면 모든 Google 계정 허용
ALLOWED_EMAIL_DOMAINS=

# 백엔드를 부를 수 있는 프론트 주소 (쉼표로 구분)
CORS_ORIGINS=http://localhost:5173

# AI 서비스가 /api/v1/skills를 부를 때 쓰는 공유 비밀 키. 비워 두면 skills API가 모두 거부된다.
SERVICE_API_KEY=

# tool 기본 시간 제한(초), ui 결과 보관 시간(초)과 최대 개수 (ui는 DB에 보관, 최대 개수는 테스트용 메모리 보관에만 쓴다)
TOOL_TIMEOUT_SECONDS=10
RESULT_TTL_SECONDS=1800
RESULT_STORE_MAX_ITEMS=1000

# 채팅: 1인당 하루(한국 시간) 보낼 수 있는 메시지 수, AI에 넘길 최근 메시지 수
DAILY_MESSAGE_LIMIT=50
CHAT_HISTORY_LIMIT=20

# AI 서비스 주소. 비워 두면 임시 답변을 쓴다. 채우면 POST {주소}/agent/respond를 부른다.
AI_SERVICE_URL=
# 백엔드가 AI 서비스를 부를 때 X-Service-Key 헤더로 보내는 공유 비밀 키
AI_SERVICE_KEY=
# AI 서비스 응답 시간 제한(초)
AI_TIMEOUT_SECONDS=30
